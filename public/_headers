# Security headers for all routes (Cloudflare Pages).
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: geolocation=(), camera=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  # CSP: clickjacking + object/base locked down; scripts/styles kept permissive so the Vite bundle,
  # ElevenLabs voice widget, Supabase and Resend keep working. Tighten script-src once sources are pinned.
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: https:; font-src 'self' data: https:; style-src 'self' 'unsafe-inline' https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; connect-src 'self' https: wss:; frame-src 'self' https:; media-src 'self' https: blob:

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');
@tailwind base;
@tailwind components;
@tailwind utilities;

html { scroll-behavior: smooth; }
body { background:#F5EFE6; color:#1A2516; -webkit-font-smoothing:antialiased; }

@layer components {
  .wrap { @apply max-w-6xl mx-auto px-5 sm:px-8; }
  .btn  { @apply inline-flex items-center justify-center gap-2 rounded-full bg-g-green px-6 py-3 font-semibold text-white shadow-soft transition hover:bg-g-dark hover:shadow-glow active:scale-[.98]; }
  .btn-gold { @apply inline-flex items-center justify-center gap-2 rounded-full bg-g-gold px-6 py-3 font-semibold text-white shadow-soft transition hover:brightness-110 active:scale-[.98]; }
  .btn-ghost { @apply inline-flex items-center justify-center gap-2 rounded-full border border-g-line bg-white/70 px-6 py-3 font-semibold text-g-word transition hover:border-g-green hover:text-g-green; }
  .card { @apply rounded-xl2 border border-g-line bg-white p-6 shadow-soft; }
  .eyebrow { @apply inline-flex items-center gap-2 rounded-full bg-g-green/10 px-3 py-1 text-xs font-bold uppercase tracking-wide text-g-dark; }
  .h2 { @apply text-3xl sm:text-4xl font-extrabold tracking-tight text-g-word; }
}

.reveal { opacity:0; transform:translateY(22px); transition:opacity .7s ease, transform .7s ease; }
.reveal.in { opacity:1; transform:none; }

# Guileo frontend: environment variables
# ─────────────────────────────────────────────────────────────────────────────
# You do NOT need a .env file to run the frontend. `npm install && npm run dev` works as is.
#
# Every value below is PUBLIC (it ships in the browser bundle anyway) and already has a built-in
# default in the code, so copying this file to `.env.local` is optional, only useful to override.
#
# Server secrets (Stripe, Twilio, ElevenLabs, Supabase service key, Resend…) are NOT frontend
# variables. They live in Cloudflare Pages → guileoai → Settings → Variables and Secrets, are read
# by `functions/` as `env.NAME`, and never go in this repo.

# Supabase: public URL + anon key (protected by Row-Level Security). Default: src/lib/supabase.js
VITE_SUPABASE_URL=https://ynihodbknhjirkdogxby.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InluaWhvZGJrbmhqaXJrZG9neGJ5Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODA2NzU5ODgsImV4cCI6MjA5NjI1MTk4OH0.yT1wPPD40EXgNdAlGPhsS_HGbH7Rt8Ok6EMzX2ECU7E

